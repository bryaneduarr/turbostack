{
  "extends": "@workspace/typescript/base",
  "display": "React.js",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@workspace/ui/*": [
        "./src/*"
      ],
      "@workspace/ui/components/*": [
        "./src/components/*"
      ],
      "@workspace/ui/ui/*": [
        "./src/components/ui/*"
      ]
    }
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
