#!/usr/bin/env bash
# Runs any command inside this work tree's stack, starting it first when needed; see usage for the stack commands.
set -eu

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
LIBRARY=$(dirname "$SCRIPT")/dc-lib

for module in state names classes stacks reaper compose image ports run commands; do
  # shellcheck source=/dev/null
  source "$LIBRARY/$module.sh"
done

main() {
  [ "$#" -gt 0 ] || usage
  if ! command -v flock >/dev/null 2>&1; then
    echo "dc: flock is missing. scripts/dc runs on Linux and WSL2; on macOS open the repository in VS Code Dev Containers." >&2
    exit 69
  fi
  if ! docker info >/dev/null 2>&1; then
    echo "dc: Docker is not running or not installed. Checks that need the container are blocked; nothing runs on the host." >&2
    exit 69
  fi
  state_init
  resolve_stack
  prepare_image
  prepare_compose
  case "$1" in
    list) list_stacks ;;
    stop) shift; stop_stacks "$@" ;;
    stop-idle) stop_idle_stacks ;;
    prune) shift; prune_stacks "$@" ;;
    down) shift; down_stack "$@" ;;
    ports) print_urls ;;
    status) compose ps ;;
    up)
      shift
      [ "${1:-}" != --build ] || ensure_image --force
      run_command true
      ;;
    shell)
      DC_LOCK=none run_command bash
      ;;
    *) run_command "$@" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
