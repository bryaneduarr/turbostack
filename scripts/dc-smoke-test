#!/usr/bin/env bash
# Proves the container workflow end to end with only Docker, git, curl, and a terminal.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dc="$root/scripts/dc"
cd "$root"

base=$((20000 + $$ % 20000))
COMPOSE_PROJECT_NAME="app-smoke-$$"
DEVCONTAINER_CLIENT_PORT=$base
DEVCONTAINER_API_PORT=$((base + 10))
export COMPOSE_PROJECT_NAME DEVCONTAINER_CLIENT_PORT DEVCONTAINER_API_PORT

failures=0

check() {
  description=$1
  shift
  if "$@" >/dev/null 2>&1; then
    echo "ok   $description"
  else
    echo "FAIL $description"
    failures=$((failures + 1))
  fi
}

cleanup() {
  rm -f .dc-smoke-probe
  docker rm -f "app-smoke-occupier-$$-$base" "app-smoke-occupier-$$-$((base + 1))" >/dev/null 2>&1 || true
  "$dc" bun run dev:stop >/dev/null 2>&1 || true
  "$dc" down -v >/dev/null 2>&1 || true
}
trap cleanup EXIT

bun_matches_package_manager() {
  wanted=$(sed -n 's/.*"packageManager": "bun@\(.*\)".*/\1/p' package.json)
  [ "$("$dc" bun --version | tr -d '\r')" = "$wanted" ]
}

files_belong_to_host_user() {
  "$dc" touch .dc-smoke-probe
  [ -n "$(find .dc-smoke-probe -user "$(id -u)")" ]
}

subdirectory_is_kept() {
  [ "$(cd apps/server && "$dc" pwd | tr -d '\r')" = /workspace/apps/server ]
}

stdin_is_forwarded() {
  [ "$(echo forwarded | "$dc" cat | tr -d '\r')" = forwarded ]
}

exit_code_is_forwarded() {
  status=0
  "$dc" sh -c 'exit 7' || status=$?
  [ "$status" -eq 7 ]
}

host_sees_dependencies() {
  [ -x node_modules/.bin/turbo ] && [ -f apps/server/.env ]
}

occupy_first_client_ports() {
  for port in "$base" $((base + 1)); do
    docker run -d --rm --name "app-smoke-occupier-$$-$port" -p "127.0.0.1:$port:9" \
      postgres:18-alpine sleep 3600
  done
}

url_of() {
  "$dc" ports | sed -n "s/^$1 //p"
}

client_skips_busy_ports() {
  [ "$(url_of client)" = "http://localhost:$((base + 2))" ]
}

other_services_keep_wanted_ports() {
  [ "$(url_of api)" = "http://localhost:$((base + 10))" ]
}

app_links_use_the_published_port() {
  [ "$("$dc" printenv CLIENT_URL | tr -d '\r')" = "$(url_of client)" ]
}

second_start_keeps_the_ports() {
  before=$("$dc" ports)
  "$dc" up
  [ "$before" = "$("$dc" ports)" ]
}

host_gets_200() {
  [ "$(curl -s -o /dev/null -w '%{http_code}' "$1")" = 200 ]
}

host_reads_dev_stack_log() {
  grep -q "Ready in" .turbo/dev-stack/dev-stack.log
}

check "two wanted ports are busy" occupy_first_client_ports
check "scripts/dc up starts the container and its services" "$dc" up
check "the client takes the next free port" client_skips_busy_ports
check "the API keeps its wanted port" other_services_keep_wanted_ports
check "app links use the published client port" app_links_use_the_published_port
check "starting again keeps the same ports" second_start_keeps_the_ports
check "bun in the container matches packageManager" bun_matches_package_manager
check "files written in the container belong to the host user" files_belong_to_host_user
check "commands run in the matching subdirectory" subdirectory_is_kept
check "standard input reaches the command" stdin_is_forwarded
check "the command exit code is returned" exit_code_is_forwarded
check "the host sees node_modules and the env files" host_sees_dependencies
check "bun run test passes inside the container" "$dc" bun run test
check "bun run dev:start brings the stack up" "$dc" bun run dev:start
check "the host reaches the client" host_gets_200 "$(url_of client)/"
check "the host reaches the API" host_gets_200 "$(url_of api)/health/live"
check "the host reads the dev stack log" host_reads_dev_stack_log
check "bun run dev:stop stops the stack" "$dc" bun run dev:stop

if [ "$failures" -gt 0 ]; then
  echo "$failures checks failed."
  exit 1
fi
echo "All checks passed."
