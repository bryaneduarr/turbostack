{
  "name": "turbostack",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "biome ci . && turbo run check-types test build",
    "check-types": "turbo check-types",
    "clean": "turbo clean && rm -rf .turbo/ node_modules",
    "db:down": "docker compose --env-file apps/server/.env down",
    "db:up": "docker compose --env-file apps/server/.env up --detach --wait postgres",
    "dev": "turbo dev",
    "drizzle:generate": "turbo drizzle:generate",
    "drizzle:migrate": "turbo drizzle:migrate",
    "drizzle:push": "turbo drizzle:push",
    "drizzle:studio": "turbo drizzle:studio",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "outdated": "bun outdated --recursive",
    "setup": "bun install && bun run db:up && bun run drizzle:migrate",
    "start": "turbo start",
    "start:docker": "docker compose --env-file apps/server/.env --profile production up --build",
    "test": "turbo test",
    "update": "bun update --interactive --recursive"
  },
  "workspaces": [
    "apps/*",
    "config/*",
    "packages/*"
  ],
  "devDependencies": {
    "@workspace/biome": "workspace:*",
    "@workspace/typescript": "workspace:*",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  }
}
