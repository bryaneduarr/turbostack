{
  "name": "turbostack",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "biome ci . && turbo boundaries && bun run check:rules && bun run check:compose && turbo run check-types test build",
    "check-types": "turbo check-types",
    "check:compose": "test \"$DEVCONTAINER\" = true && echo \"Skipped: the devcontainer has no Docker; run this on the host.\" || docker compose --env-file apps/server/.env.example config --quiet",
    "check:rules": "bun run --cwd config/rules check-rules",
    "clean": "turbo clean && rm -rf .turbo/ node_modules",
    "db:down": "docker compose --env-file apps/server/.env down",
    "db:provision": "bun run --cwd apps/server db:provision",
    "db:up": "bun run --cwd config/setup db:up",
    "dev": "bun run --cwd config/setup dev-entry",
    "dev:start": "bun scripts/dev-stack.script.ts start",
    "dev:status": "bun scripts/dev-stack.script.ts status",
    "dev:stop": "bun scripts/dev-stack.script.ts stop",
    "doctor": "bun run --cwd config/setup doctor",
    "doctor:stack": "bun run --cwd config/setup doctor:stack",
    "drizzle:generate": "turbo drizzle:generate",
    "drizzle:migrate": "turbo drizzle:migrate",
    "drizzle:push": "turbo drizzle:push",
    "drizzle:studio": "turbo drizzle:studio",
    "format": "biome check --write .",
    "lint": "biome lint .",
    "outdated": "bun outdated --recursive",
    "rename-scope": "bun scripts/rename-workspace-scope.script.ts",
    "seed:dev": "bun run --cwd apps/server seed:dev",
    "setup": "bun install && bun run setup:env",
    "setup:env": "bun run --cwd config/setup setup:env",
    "start": "turbo start",
    "start:docker": "docker compose --env-file apps/server/.env --profile production up --build",
    "test": "turbo test",
    "update": "bun update --interactive --recursive",
    "update:toolchain": "bun scripts/update-toolchain.script.ts",
    "verify": "bun scripts/verify-workspace.script.ts"
  },
  "workspaces": [
    "apps/*",
    "config/*",
    "packages/*"
  ],
  "devDependencies": {
    "@workspace/biome": "workspace:*",
    "@workspace/typescript": "workspace:*",
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.9"
  }
}
