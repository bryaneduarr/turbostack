{
  "name": "turbostack",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "scripts/in-stack bunx turbo build",
    "check-types": "scripts/in-stack bunx turbo check-types",
    "check:compose": "test \"$DEVCONTAINER\" = true && echo \"Skipped: the devcontainer has no Docker; run this on the host.\" || docker compose --env-file apps/server/.env.example config --quiet",
    "check:rules": "scripts/in-stack bun run --cwd config/rules check-rules",
    "clean": "scripts/in-stack sh -c 'bunx turbo clean && rm -rf .turbo/ node_modules'",
    "db:down": "docker compose --env-file apps/server/.env down",
    "db:provision": "scripts/in-stack bun run --cwd apps/server db:provision",
    "db:up": "scripts/in-stack bun run --cwd config/setup db:up",
    "dev": "scripts/in-stack bun run --cwd config/setup dev-entry",
    "dev:start": "scripts/in-stack bun scripts/dev-stack.script.ts start",
    "dev:status": "scripts/in-stack bun scripts/dev-stack.script.ts status",
    "dev:stop": "scripts/in-stack bun scripts/dev-stack.script.ts stop",
    "doctor": "scripts/in-stack bun run --cwd config/setup doctor",
    "doctor:stack": "scripts/in-stack bun run --cwd config/setup doctor:stack",
    "drizzle:generate": "scripts/in-stack bunx turbo drizzle:generate",
    "drizzle:migrate": "scripts/in-stack bunx turbo drizzle:migrate",
    "drizzle:push": "scripts/in-stack bunx turbo drizzle:push",
    "drizzle:studio": "scripts/in-stack bunx turbo drizzle:studio",
    "format": "scripts/in-stack bunx biome check --write .",
    "lint": "scripts/in-stack bunx biome lint .",
    "outdated": "scripts/in-stack bun outdated --recursive",
    "rename-scope": "scripts/in-stack bun scripts/rename-workspace-scope.script.ts",
    "seed:dev": "scripts/in-stack bun run --cwd apps/server seed:dev",
    "setup": "scripts/in-stack sh -c 'bun install && bun run setup:env'",
    "setup:env": "scripts/in-stack bun run --cwd config/setup setup:env",
    "start": "scripts/in-stack bunx turbo start",
    "start:docker": "docker compose --env-file apps/server/.env --profile production up --build",
    "test:e2e": "scripts/in-stack bunx turbo test:e2e --",
    "test:e2e:install": "scripts/in-stack bun run --cwd apps/client test:e2e:install",
    "test:e2e:only": "scripts/in-stack bun scripts/run-browser-tests.script.ts",
    "update": "scripts/in-stack bun update --interactive --recursive",
    "update:toolchain": "scripts/in-stack bun scripts/dependencies/update-toolchain.script.ts",
    "verify": "scripts/in-stack bun scripts/verify-workspace.script.ts"
  },
  "workspaces": [
    "apps/*",
    "config/*",
    "packages/*"
  ],
  "devDependencies": {
    "@workspace/biome": "workspace:*",
    "@workspace/typescript": "workspace:*",
    "turbo": "^2.11.10"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.9"
  }
}
