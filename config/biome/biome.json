{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "formatter": {
    "enabled": true,
    "lineWidth": 80,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useOptionalChain": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [":PATH:"],
                "message": "Use @workspace/<package>/... for package modules or @/... for app-local modules instead of filesystem imports."
              },
              {
                "group": [
                  "@/**/*.js",
                  "@/**/*.jsx",
                  "@/**/*.mjs",
                  "@/**/*.cjs",
                  "@/**/*.ts",
                  "@/**/*.tsx",
                  "@/**/*.mts",
                  "@/**/*.cts",
                  "@workspace/**/*.js",
                  "@workspace/**/*.jsx",
                  "@workspace/**/*.mjs",
                  "@workspace/**/*.cjs",
                  "@workspace/**/*.ts",
                  "@workspace/**/*.tsx",
                  "@workspace/**/*.mts",
                  "@workspace/**/*.cts"
                ],
                "message": "Omit JavaScript and TypeScript file extensions from project module aliases."
              }
            ]
          }
        },
        "useConst": "warn",
        "noExportedImports": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "suspicious": {
        "noDeprecatedImports": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useImportExtensions": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "off"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
      "!**/next-env.d.ts",
      "!**/dist/**",
      "!**/build/**",
      "!**/.turbo/**",
      "!**/.next/**",
      "!**/package-lock.json",
      "!**/pnpm-lock.yaml",
      "!**/node_modules/**"
    ]
  },
  "overrides": [
    {
      "includes": ["**/postcss.config.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
