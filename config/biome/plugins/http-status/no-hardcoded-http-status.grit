language js

// Only the canonical catalog may spell out HTTP status numbers.
or {
  `status: $value`,
  `statusCode: $value`,
  `$_.status($value)`,
  `$_.status = $value`,
  `$value: $_` where { $value <: r"^[1-5][0-9]{2}$" },
  `expect($subject).$_($value)` where { $subject <: contains r"(?i).*status.*" },
  `$left === $value` where { $left <: contains r"(?i).*status.*" },
  `$left !== $value` where { $left <: contains r"(?i).*status.*" },
  `$left < $value` where { $left <: contains r"(?i).*status.*" },
  `$left <= $value` where { $left <: contains r"(?i).*status.*" },
  `$left > $value` where { $left <: contains r"(?i).*status.*" },
  `$left >= $value` where { $left <: contains r"(?i).*status.*" }
} where {
  $value <: r"^[1-5][0-9]{2}$",
  $filename <: not r".*/http-status-code\.constant\.ts$",
  register_diagnostic(
    span = $value,
    message = "Use the named HTTP status constant from @workspace/utils/http/status-codes/http-status-code.constant instead of a hardcoded status."
  )
}
