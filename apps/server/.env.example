NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_SSL_MODE=disable

# Each process connects as its own role; `bun run db:provision` and the local
# container create the roles with these passwords. The admin role is used only
# for provisioning.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD="example-admin-password"
DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD="example-migrator-password"
DB_USER=app_runtime
DB_PASSWORD="example-runtime-password"
DB_CLI_USER=app_cli
DB_CLI_PASSWORD="example-cli-password"

# Optional; the values shown are the defaults.
# CLIENT_URL=http://localhost:3000
# SHUTDOWN_TIMEOUT_SECONDS=30
# SHUTDOWN_DRAIN_DELAY_SECONDS=0
# HTTP_IDLE_TIMEOUT_SECONDS=75
# MAX_REQUEST_BODY_BYTES=1048576
# LOG_LEVEL=debug
# OPENAPI_ENABLED=true
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_IDLE_TIMEOUT_SECONDS=0
# DB_PREPARE=true
# DB_SHUTDOWN_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_SECONDS=30
# DB_MIGRATION_LOCK_TIMEOUT_SECONDS=10
