PORT=3001

NODE_ENV=development

# Allowed browser origin for CORS. Defaults to http://localhost:3000.

CLIENT_URL=http://localhost:3000

SHUTDOWN_TIMEOUT_SECONDS=30

# Larger request bodies are rejected with 413. Defaults to 1 MiB.

MAX_REQUEST_BODY_BYTES=1048576

# Defaults to debug in development, silent in test, info in production.

LOG_LEVEL=debug

# Serves /api/v1/reference and /api/v1/doc. Defaults to false in production.

OPENAPI_ENABLED=true

# PostgreSQL Database configuration (matches docker-compose.yml)

DB_HOST=localhost

DB_PORT=5432

DB_USER=postgres

DB_PASSWORD="example-local-password"

DB_NAME=postgres

DB_SSL_MODE=disable

DB_POOL_MAX=10

DB_CONNECT_TIMEOUT_SECONDS=10

DB_IDLE_TIMEOUT_SECONDS=0

DB_PREPARE=true

DB_SHUTDOWN_TIMEOUT_SECONDS=5
