NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD="example-local-password"
DB_NAME=postgres
DB_SSL_MODE=disable

# Optional; the values shown are the defaults.
# CLIENT_URL=http://localhost:3000
# SHUTDOWN_TIMEOUT_SECONDS=30
# SHUTDOWN_DRAIN_DELAY_SECONDS=0
# HTTP_IDLE_TIMEOUT_SECONDS=75
# MAX_REQUEST_BODY_BYTES=1048576
# LOG_LEVEL=debug
# OPENAPI_ENABLED=true
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_IDLE_TIMEOUT_SECONDS=0
# DB_PREPARE=true
# DB_SHUTDOWN_TIMEOUT_SECONDS=5
