{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/db/migrate/apply-migrations.script.ts --root src --target bun --outdir dist --sourcemap=linked && cp -r src/db/migrations dist/db/migrations",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./dist ./node_modules/ ./.turbo/",
    "dev": "bun --watch src/index.ts",
    "drizzle:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config ./drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "bun dist/index.js",
    "start:migrate": "bun dist/db/migrate/apply-migrations.script.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@workspace/schemas": "workspace:*",
    "@workspace/utils": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scalar/types": "^0.23.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "vitest": "^5.0.4"
  }
}
