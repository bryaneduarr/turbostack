{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./dist ./node_modules/ ./.turbo/",
    "dev": "bun --watch src/index.ts",
    "drizzle:generate": "bunx drizzle-kit generate --config ./drizzle.config.ts",
    "drizzle:migrate": "bunx drizzle-kit migrate --config ./drizzle.config.ts",
    "drizzle:push": "bunx drizzle-kit push --config ./drizzle.config.ts",
    "drizzle:studio": "bunx drizzle-kit studio --config ./drizzle.config.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "bun ./dist/src/index.js",
    "update": "bun update --latest"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@scalar/types": "^0.23.2",
    "@workspace/schemas": "workspace:*",
    "@workspace/utils": "workspace:*",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "tsc-alias": "^1.9.7"
  }
}
