{
  "name": "api-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/db/migrate/apply-migrations.script.ts src/db/provision/provision-database.script.ts --root src --target bun --outdir dist --sourcemap=linked && cp -r ../../packages/database/src/migrations dist/db/migrations && cp -r src/db/provision/initdb dist/db/provision/initdb",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./dist ./node_modules/ ./.turbo/",
    "db:provision": "bun src/db/provision/provision-database.script.ts",
    "db:test:prepare": "bun src/db/testing/test-database/prepare-test-database.script.ts",
    "dev": "bun --watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "seed:dev": "bun src/db/seed/seed-development.script.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "start:migrate": "bun dist/db/migrate/apply-migrations.script.js",
    "start:provision": "bun dist/db/provision/provision-database.script.js",
    "test": "NODE_ENV=test bun test",
    "test:watch": "NODE_ENV=test bun test --watch"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.16",
    "@workspace/database": "workspace:*",
    "@workspace/schemas": "workspace:*",
    "@workspace/utils": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scalar/types": "^0.25.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0"
  }
}
