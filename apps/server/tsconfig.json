{
  "extends": "@workspace/typescript/base",
  "compilerOptions": {
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/package.json": ["./package.json"],
      "@/*": ["./src/*"]
    },
    "types": ["bun"]
  },
  "exclude": ["./dist/", "./node_modules/"]
}
