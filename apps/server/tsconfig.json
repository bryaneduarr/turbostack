{
  "extends": "@workspace/typescript/base",
  "compilerOptions": {
    "paths": {
      "@/package.json": ["./package.json"],
      "@/*": [
        "./src/*"
      ]
    },
    "outDir": "./dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "./dist/",
    "./node_modules/"
  ]
}
