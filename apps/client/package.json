{
  "name": "web-client",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build && cp -r .next/static .next/standalone/apps/client/.next/static",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf node_modules/ .turbo/ .next/",
    "dev": "next dev --turbopack",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node --env-file-if-exists=.env .next/standalone/apps/client/server.js",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@workspace/api-client": "workspace:*",
    "@workspace/schemas": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/database": "workspace:*",
    "@workspace/tailwind": "workspace:*",
    "tailwindcss": "^4.3.3"
  }
}
