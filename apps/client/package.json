{
  "name": "web-client",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build && cp -r .next/static .next/standalone/apps/client/.next/static",
    "clean": "rm -rf node_modules/ .turbo/ .next/",
    "check-types": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node --env-file-if-exists=.env .next/standalone/apps/client/server.js"
  },
  "dependencies": {
    "@workspace/api-client": "workspace:*",
    "@workspace/schemas": "workspace:*",
    "@workspace/ui": "workspace:*",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/tailwind": "workspace:*",
    "tailwindcss": "^4.3.3"
  }
}
