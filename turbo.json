{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "CLIENT_URL",
    "SERVER_URL",
    "LOG_LEVEL",
    "OPENAPI_ENABLED",
    "MAX_REQUEST_BODY_BYTES",
    "HTTP_*",
    "SHUTDOWN_*",
    "DB_*",
    "DEVCONTAINER"
  ],
  "boundaries": {
    "tags": {
      "app": {
        "dependents": {
          "allow": []
        }
      },
      "package": {
        "dependencies": {
          "deny": [
            "app"
          ]
        }
      },
      "runtime-neutral": {
        "dependencies": {
          "allow": [
            "runtime-neutral",
            "config"
          ]
        }
      },
      "server": {
        "dependencies": {
          "deny": [
            "browser"
          ]
        }
      },
      "config": {
        "dependencies": {
          "allow": [
            "config",
            "runtime-neutral"
          ]
        }
      }
    }
  },
  "tasks": {
    "//#db:up": {
      "cache": false
    },
    "//#doctor:stack": {
      "cache": false,
      "dependsOn": [
        "api-server#seed:dev"
      ]
    },
    "api-server#db:provision": {
      "cache": false,
      "dependsOn": [
        "//#db:up"
      ]
    },
    "api-server#seed:dev": {
      "cache": false,
      "dependsOn": [
        "@workspace/database#drizzle:migrate"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "api-server#seed:dev",
        "//#doctor:stack"
      ]
    },
    "drizzle:check": {
      "cache": false
    },
    "drizzle:generate": {
      "cache": false
    },
    "drizzle:migrate": {
      "cache": false,
      "dependsOn": [
        "//#db:up",
        "api-server#db:provision"
      ]
    },
    "drizzle:push": {
      "cache": false
    },
    "drizzle:studio": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build",
        "//#db:up"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "build",
        "^drizzle:migrate",
        "api-server#build"
      ],
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_*",
        "NIX_LD*"
      ]
    }
  }
}
