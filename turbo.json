{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "CLIENT_URL",
    "SERVER_URL",
    "LOG_LEVEL",
    "OPENAPI_ENABLED",
    "MAX_REQUEST_BODY_BYTES",
    "HTTP_*",
    "SHUTDOWN_*",
    "DB_*"
  ],
  "boundaries": {
    "tags": {
      "app": {
        "dependents": { "allow": [] }
      },
      "package": {
        "dependencies": { "deny": ["app"] }
      },
      "runtime-neutral": {
        "dependencies": { "allow": ["runtime-neutral", "config"] }
      },
      "server": {
        "dependencies": { "deny": ["browser"] }
      },
      "config": {
        "dependencies": { "allow": ["config"] }
      }
    }
  },
  "tasks": {
    "//#db:up": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#db:up"]
    },
    "drizzle:check": {
      "cache": false
    },
    "drizzle:generate": {
      "cache": false
    },
    "drizzle:migrate": {
      "cache": false
    },
    "drizzle:push": {
      "cache": false
    },
    "drizzle:studio": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build", "//#db:up"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    }
  }
}
